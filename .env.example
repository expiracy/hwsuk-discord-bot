# Copy to .env and fill in the bot token, server IDs, database password, and API credentials.
# Compose mounts passwords/tokens as secrets; they are not baked into either image.
DISCORD_TOKEN='REPLACE_WITH_BOT_TOKEN'
DISCORD_SERVER_ID='REPLACE_WITH_SERVER_ID'
DISCORD_UPDATER_ROLE=0
DISCORD_VERIFIED_ROLE=0
REACTION_CHANNEL_ID=0
MOD_CHANNEL_ID=0
REACTION_THRESHOLD=3
EMBED_REMOVER_CHANNEL_ID=0
BUY_SELL_CHANNEL_ID=0
BUY_SELL_LIMIT_SECONDS=259200
BUY_SELL_BACKUP_DM_CHANNEL_ID=0
REPORT_CHANNEL_ID=0

# The bundled database is initialised automatically. Choose a unique strong password.
# Keep these values when recreating containers; changing .env alone does not rotate a stored password.
MONGODB_DATABASE=hwsuk
MONGODB_USERNAME=hwsuk_bot
MONGODB_PASSWORD='REPLACE_WITH_STRONG_DATABASE_PASSWORD'

PRAW_CLIENT_ID='REPLACE_WITH_REDDIT_CLIENT_ID'
PRAW_CLIENT_SECRET='REPLACE_WITH_REDDIT_CLIENT_SECRET'
PRAW_USERNAME='HWSUKMods'
PRAW_PASSWORD='REPLACE_WITH_REDDIT_PASSWORD'
PRAW_USER_AGENT='script:hwsuk-discord-bot:1.0 (by u/HWSUKMods)'
DVLA_API_KEY='REPLACE_WITH_MOT_API_KEY'

# For a test with only the Discord-only cogs enabled in config.json, use 'unused'
# for the Reddit/MOT secrets. The full default cog list requires valid integrations.
